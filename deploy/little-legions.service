# /etc/systemd/system/little-legions.service  (deploy tanpa Docker)
# sudo cp deploy/little-legions.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now little-legions
# sudo journalctl -u little-legions -f

[Unit]
Description=Little Legions (Unity WebGL) server
After=network.target

[Service]
Type=simple
User=littlelegions
Group=littlelegions
WorkingDirectory=/opt/little-legions
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=GAME_DIR=/opt/little-legions/game
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/little-legions
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
