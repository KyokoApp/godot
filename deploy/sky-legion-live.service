# /etc/systemd/system/sky-legion-live.service
# sudo cp deploy/sky-legion-live.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now sky-legion-live
# sudo journalctl -u sky-legion-live -f

[Unit]
Description=Sky Legion Live — TikTok battle arena
After=network.target

[Service]
Type=simple
User=legion
Group=legion
WorkingDirectory=/opt/sky-legion-live
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
EnvironmentFile=-/opt/sky-legion-live/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sky-legion-live
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
