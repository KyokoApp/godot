# /etc/systemd/system/skyrunner.service  (deploy tanpa Docker)
# sudo cp deploy/skyrunner.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now skyrunner
# sudo journalctl -u skyrunner -f

[Unit]
Description=Sky Runner game server
After=network.target

[Service]
Type=simple
User=skyrunner
Group=skyrunner
WorkingDirectory=/opt/skyrunner/server
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DB_PATH=/var/lib/skyrunner/skyrunner.db
Environment=STATIC_DIR=/opt/skyrunner/game/dist
Environment=SERVE_STATIC=1
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skyrunner
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
